# Ciel LLM Configuration
# ========================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains your API key.
#
# Usage:
#   cp .env.example .env
#   nano .env   # fill in CIEL_API_KEY
#   python3 -m Ciel run "what is my disk usage?"

# Your API key for the Qwen cloud (DashScope) service.
# Get one at: https://dashscope.aliyuncs.com/
CIEL_API_KEY=your-api-key-here

# OpenAI-compatible endpoint for Qwen cloud.
# Change this if you are using a local or proxy endpoint.
CIEL_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model identifier. Qwen cloud model names:
#   qwen-max          — highest capability
#   qwen-plus         — balanced speed/cost
#   qwen-turbo        — fastest, lowest cost
CIEL_MODEL=qwen-max

# Per-request HTTP timeout in seconds.
# Increase this if you are on a slow connection.
CIEL_REQUEST_TIMEOUT=30.0

# Maximum number of retry attempts for transient errors (429, 5xx).
# Set to 0 to disable retries.
CIEL_MAX_RETRIES=3
